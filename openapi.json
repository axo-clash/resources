{
    "openapi": "3.1.0",
    "info": {
        "title": "axoclash",
        "description": "AXOPEN Starter Project",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8080",
            "description": "Generated server url"
        }
    ],
    "tags": [
        {
            "name": "Bot",
            "description": "Bot API"
        }
    ],
    "paths": {
        "/info": {
            "get": {
                "tags": [
                    "Bot"
                ],
                "summary": "Get Bot Information",
                "operationId": "getBotInfo",
                "responses": {
                    "200": {
                        "description": "Bot information retrieved successfully",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/BotInfoDTO"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "An error occurred while getting bot information",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/BotInfoDTO"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/play": {
            "post": {
                "tags": [
                    "Bot"
                ],
                "summary": "Play Action",
                "operationId": "play",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/GameBotDTO"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Action played successfully",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/PlayResponseDTO"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request data",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/PlayResponseDTO"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "An error occurred while processing the action",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/PlayResponseDTO"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ActionDTO": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "botId": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "action": {
                        "type": "string",
                        "enum": [
                            "MOVE_LEFT",
                            "MOVE_RIGHT",
                            "MOVE_UP",
                            "MOVE_DOWN",
                            "SHOOT_LEFT",
                            "SHOOT_RIGHT",
                            "SHOOT_UP",
                            "SHOOT_DOWN",
                            "UNKNOWN"
                        ]
                    },
                    "forbidden": {
                        "type": "boolean"
                    },
                    "executionTimeMs": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "createdDate": {
                        "type": "number",
                        "format": "double"
                    }
                }
            },
            "BotDTO": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "name": {
                        "type": "string"
                    },
                    "version": {
                        "type": "string"
                    },
                    "url": {
                        "type": "string"
                    },
                    "data": {
                        "$ref": "#/components/schemas/BotDataDTO"
                    },
                    "botType": {
                        "type": "string",
                        "enum": [
                            "FIRST_BOT",
                            "SECOND_BOT"
                        ]
                    },
                    "coordinates": {
                        "$ref": "#/components/schemas/CoordDTO"
                    },
                    "faster": {
                        "type": "boolean"
                    }
                }
            },
            "BotDataDTO": {
                "type": "object",
                "properties": {
                    "life": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "forbiddenActions": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "state": {
                        "type": "string",
                        "enum": [
                            "UNKNOWN",
                            "READY",
                            "PLAYING",
                            "WAITING_FOR_OPPONENT"
                        ]
                    },
                    "lastActionTimeMs": {
                        "type": "integer",
                        "format": "int64"
                    }
                }
            },
            "CaseDTO": {
                "type": "object",
                "properties": {
                    "coordinates": {
                        "$ref": "#/components/schemas/CoordDTO"
                    },
                    "content": {
                        "type": "string",
                        "enum": [
                            "FIRST_BOT",
                            "SECOND_BOT",
                            "BULLET_LEFT",
                            "BULLET_RIGHT",
                            "BULLET_UP",
                            "BULLET_DOWN"
                        ]
                    },
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ItemDTO"
                        }
                    }
                }
            },
            "CoordDTO": {
                "type": "object",
                "properties": {
                    "x": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "y": {
                        "type": "integer",
                        "format": "int32"
                    }
                }
            },
            "GameDTO": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "firstBot": {
                        "$ref": "#/components/schemas/BotDTO"
                    },
                    "secondBot": {
                        "$ref": "#/components/schemas/BotDTO"
                    },
                    "board": {
                        "type": "array",
                        "items": {
                            "type": "array",
                            "items": {
                                "$ref": "#/components/schemas/CaseDTO"
                            }
                        }
                    },
                    "currentTurn": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "actions": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ActionDTO"
                        }
                    },
                    "winner": {
                        "type": "string",
                        "enum": [
                            "FIRST_BOT",
                            "SECOND_BOT",
                            "DRAW"
                        ]
                    },
                    "endReason": {
                        "type": "string",
                        "enum": [
                            "FIRST_BOT_LIFE",
                            "SECOND_BOT_LIFE",
                            "FIRST_BOT_FORBIDDEN_ACTION",
                            "SECOND_BOT_FORBIDDEN_ACTION",
                            "GAME_TURN"
                        ]
                    },
                    "failureReason": {
                        "type": "string",
                        "enum": [
                            "BOT_CONNECTION_ERROR",
                            "BOT_INFO_RETRIEVAL_ERROR",
                            "GAME_EXECUTION_ERROR",
                            "INVALID_BOARD_STATE",
                            "BOT_COMMUNICATION_TIMEOUT",
                            "JSON_PROCESSING_ERROR",
                            "UNKNOWN_ERROR"
                        ]
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "STARTING",
                            "RUNNING",
                            "PAUSED",
                            "FINISHED",
                            "FAILED"
                        ]
                    }
                }
            },
            "ItemDTO": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "enum": [
                            "BULLET_LEFT",
                            "BULLET_RIGHT",
                            "BULLET_UP",
                            "BULLET_DOWN"
                        ]
                    },
                    "owner": {
                        "$ref": "#/components/schemas/BotDTO"
                    }
                }
            },
            "GameBotDTO": {
                "type": "object",
                "properties": {
                    "game": {
                        "$ref": "#/components/schemas/GameDTO"
                    },
                    "bot": {
                        "$ref": "#/components/schemas/BotDTO"
                    }
                }
            },
            "PlayResponseDTO": {
                "type": "object",
                "properties": {
                    "action": {
                        "type": "string",
                        "enum": [
                            "MOVE_LEFT",
                            "MOVE_RIGHT",
                            "MOVE_UP",
                            "MOVE_DOWN",
                            "SHOOT_LEFT",
                            "SHOOT_RIGHT",
                            "SHOOT_UP",
                            "SHOOT_DOWN",
                            "UNKNOWN"
                        ]
                    }
                }
            },
            "BotInfoDTO": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "version": {
                        "type": "string"
                    }
                }
            }
        }
    }
}

